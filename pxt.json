{
    "name": "compass-ble",
    "version": "0.0.1",
    "description": "Exposes the compass bearing over BLE via the micro:bit Magnetometer Service",
    "dependencies": {
        "core": "*",
        "bluetooth": "*"
    },
    "files": [
        "main.ts"
    ],
    "targetVersions": {
        "target": "*"
    },
    "yotta": {
        "config": {
            "microbit-dal": {
                "gatt_table_size": "0x700",
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null,
                    "event_service": 0,
                    "eddystone_url": 0,
                    "eddystone_uid": 0,
                    "dfu_service": 0,
                    "partial_flashing": 0,
                    "device_info_service": 0
                }
            }
        }
    }
}
